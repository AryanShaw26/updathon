generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum HackathonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  DEADLINE
  ROUND_START
  ROUND_END
  CUSTOM
}

model Hackathon {
  id          String                @id @default(cuid())
  name        String
  organizer   String?
  description String?
  website     String?
  startDate   DateTime
  endDate     DateTime
  status      HackathonStatus       @default(UPCOMING)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  team        Team?
  project     Project?
  rounds      HackathonRound[]
  tasks       Task[]
  notifications NotificationSetting[]

  @@index([status, startDate])
}

model Team {
  id          String       @id @default(cuid())
  hackathonId String       @unique
  teamName    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  hackathon   Hackathon    @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  members     TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  email     String?
  role      String?
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Project {
  id            String    @id @default(cuid())
  hackathonId   String    @unique
  projectName   String
  description   String?
  repositoryUrl String?
  demoUrl       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  hackathon     Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

model HackathonRound {
  id          String                @id @default(cuid())
  hackathonId String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      HackathonStatus       @default(UPCOMING)
  createdAt   DateTime              @default(now())
  hackathon   Hackathon             @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  tasks       Task[]
  notifications NotificationSetting[]

  @@index([hackathonId, startDate])
}

model Task {
  id          String                @id @default(cuid())
  hackathonId String
  roundId     String?
  title       String
  description String?
  status      TaskStatus            @default(TODO)
  priority    TaskPriority          @default(MEDIUM)
  deadline    DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  hackathon   Hackathon             @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  round       HackathonRound?       @relation(fields: [roundId], references: [id], onDelete: SetNull)
  notifications NotificationSetting[]

  @@index([hackathonId, status])
  @@index([deadline])
}

model NotificationSetting {
  id               String           @id @default(cuid())
  hackathonId      String
  taskId           String?
  roundId          String?
  enabled          Boolean          @default(true)
  notificationTime DateTime
  notificationType NotificationType
  createdAt        DateTime         @default(now())
  hackathon        Hackathon        @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  task             Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  round            HackathonRound?  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([enabled, notificationTime])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
